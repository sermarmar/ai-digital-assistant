# Copia este archivo a .env y rellena los valores. El .env nunca se sube al repositorio.
# scripts/setup.sh lo copia por ti si todavía no existe.

# --- Claude ---
# subscription (por defecto, usa el plan Pro) o api (pago por token)
CLAUDE_PROVIDER=subscription
# Solo en modo api. En modo subscription DEBE quedar vacía: si tiene valor, se usa y se cobra por token.
ANTHROPIC_API_KEY=
# Solo en modo subscription. Se genera con `claude setup-token` (abre el navegador para
# aprobarlo, requiere plan Pro o superior y dura un año). Va en UNA sola línea. Es personal: no lo compartas.
# Si se deja vacío, se usa el login de Claude Code de este ordenador.
CLAUDE_CODE_OAUTH_TOKEN=
MODEL_FAST=claude-haiku-5-5
MODEL_MAIN=claude-sonnet-5-5

# --- Transcripción (Whisper local) ---
STT_URL=http://127.0.0.1:8000
# Modelo de Whisper: small (recomendado para empezar), medium o large-v3 (más preciso y más lento)
WHISPER_MODEL=small
# Idioma por defecto de la transcripción. Vacío = detección automática
WHISPER_LANGUAGE=es

# --- Base de datos (SQLite) ---
# Archivo donde se guardan las reuniones, relativo a la carpeta del proyecto
DATABASE_PATH=./data/reuniones.db
# Carpeta donde espera el archivo de audio o vídeo subido mientras se transcribe; después se borra
UPLOADS_DIR=./data/uploads

# --- API ---
# Puerto de la API (solo accesible desde este ordenador). La web se abre en http://localhost:5173
API_PORT=3000
