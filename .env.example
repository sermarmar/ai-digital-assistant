# Copia este archivo a .env y rellena los valores. El .env nunca se sube al repositorio.

# --- Claude ---
# subscription (por defecto, usa el plan Pro) o api (pago por token)
CLAUDE_PROVIDER=subscription
# Solo en modo api. En modo subscription DEBE quedar vacía: si tiene valor, se usa y se cobra por token.
ANTHROPIC_API_KEY=
# Solo en modo subscription. Se genera con `claude setup-token` (abre el navegador para
# aprobarlo, requiere plan Pro o superior y dura un año). Es personal: no lo compartas.
CLAUDE_CODE_OAUTH_TOKEN=
MODEL_FAST=claude-haiku-5-5
MODEL_MAIN=claude-sonnet-5-5

# --- Transcripción (Whisper local) ---
STT_URL=http://stt:8000
# Modelo de Whisper: small (recomendado para empezar), medium o large-v3 (más preciso y más lento)
WHISPER_MODEL=small
# Idioma por defecto de la transcripción. Vacío = detección automática
WHISPER_LANGUAGE=es

# --- Base de datos ---
# docker-compose construye DATABASE_URL para el servicio api a partir de estas tres.
# Evita los caracteres @ : / # en la clave: va dentro de una URL.
POSTGRES_USER=reuniones
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=reuniones

# --- Puertos (solo accesibles desde este ordenador) ---
API_PORT=3000
# La app se abre en http://localhost:8080
WEB_PORT=8080
