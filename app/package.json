{
  "name": "MeetingAssistant",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/build-mermaid-page.mjs",
    "start": "react-native start",
    "macos": "react-native run-macos",
    "windows": "react-native run-windows",
    "build:macos": "bash scripts/build-macos-portable.sh",
    "build:windows": "pwsh -File scripts/build-windows-portable.ps1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mermaid": "^12.2.0",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-macos": "^0.83.0",
    "react-native-webview": "^16.0.0",
    "react-native-windows": "^0.83.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native-windows/find-dotnet-tools": "^0.84.1",
    "@react-native/babel-preset": "0.83.10",
    "@react-native/eslint-config": "0.83.10",
    "@react-native/metro-config": "0.83.10",
    "@react-native/typescript-config": "0.83.10",
    "@types/react": "^19.2.0",
    "eslint": "^8.19.0",
    "prettier": "2.8.8",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "react-native-windows": {
    "init-windows": {
      "name": "MeetingAssistant",
      "namespace": "MeetingAssistant",
      "template": "cpp-app"
    }
  }
}
